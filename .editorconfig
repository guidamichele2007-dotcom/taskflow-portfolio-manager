root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_filename = disabled

# @Composable functions are PascalCase by the Jetpack Compose style guide
# itself (they emit UI, conceptually closer to a type than a verb) — the
# stock ktlint ruleset has no @Composable exception for function-naming, so
# every Omni* component would otherwise be flagged. TDR-22 / core-designsystem.
[core/core-designsystem/**.kt]
ktlint_standard_function-naming = disabled

[*.go]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_size = 2

[*.swift]
indent_size = 4
